# ============================================================
#  NestIQ — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
BASE_URL=http://localhost:5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?appName=<APP_NAME>

# JWT Secret — generate a strong 64-character random string
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_64_CHARACTER_STRING

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID

# Nodemailer — Gmail or SMTP credentials for sending real emails
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_not_your_real_password

# Admin notification email
ADMIN_EMAIL=your_admin_email@gmail.com

# Cookie Settings (set to 'true' in production with HTTPS)
COOKIE_SECURE=false

# Client URL (your frontend URL, used for CORS)
CLIENT_URL=http://localhost:5500
